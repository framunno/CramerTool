// Windows resources for CramerTool.exe: application icon and the version
// information shown in Explorer (right click > Properties > Details).
// Generated by cmake/Version.cmake; edit the .in template, not the output.

#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/resources/cramertool.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Francesco Ramunno"
            VALUE "FileDescription",  "CramerTool - linear systems solved with Cramer's rule"
            VALUE "FileVersion",      "@CRAMERTOOL_VERSION_STRING@"
            VALUE "InternalName",     "CramerTool"
            VALUE "LegalCopyright",   "Copyright (c) @CRAMERTOOL_BUILD_YEAR@ Francesco Ramunno. MIT License."
            VALUE "OriginalFilename", "CramerTool.exe"
            VALUE "ProductName",      "CramerTool"
            VALUE "ProductVersion",   "@CRAMERTOOL_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
